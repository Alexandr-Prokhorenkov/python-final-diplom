SECRET_KEY=change-me-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SQLite for local development (venv + runserver).
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL с хоста к контейнеру db:
# DATABASE_URL=postgres://orders:orders@127.0.0.1:5432/orders

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# True — без Redis, задачи выполняются сразу в процессе Django.
# False — нужен Redis и worker. В docker compose это задаётся автоматически.
CELERY_TASK_ALWAYS_EAGER=True

# Пароли Postgres для docker compose (web/worker подставляют хост db сами).
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False

ADMIN_EMAIL=admin@example.com
